APP_NAME="PolytronX - RIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-portal-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Hostinger Business: single MySQL database from hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session auth for the React SPA (same-origin cookie sessions).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Sanctum SPA stateful domains (comma separated, include dev origins).
SANCTUM_STATEFUL_DOMAINS=your-portal-domain.com,localhost:3000,127.0.0.1:3000
SESSION_PORTAL_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail (Hostinger: use the account's SMTP credentials from hPanel).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Platform (SaaS) configuration
RIS_SUPER_ADMIN_EMAIL=
RIS_SUPER_ADMIN_PASSWORD=

# Demo data (fake clinic + patients) — local dev / CI e2e ONLY.
# MUST stay false in production: seeders and demo endpoints are inert unless true.
RIS_DEMO_MODE=false
RIS_DEMO_TENANT_CODE=DEMO-2026
RIS_DEMO_ADMIN_EMAIL=
RIS_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
