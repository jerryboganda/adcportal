APP_NAME="PolytronX - Enterprise PACS & RIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-portal-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# The clinic's own timezone. This is NOT the server's timezone: the calendar day
# a study is booked, a shift is closed and a report is stamped all follow it, and
# the SPA derives "today" the same way. config/app.php defaults to Asia/Karachi
# for the same reason — set it here only if the deployment zone changes.
APP_TIMEZONE=Asia/Karachi

# ---- Public clinic registration (POST /api/v1/register) ----
# The endpoint provisions a full tenant. Flip RIS_REGISTRATION_ENABLED=false to
# close it (tenants are then created by the platform operator). While it is open,
# RIS_REGISTRATION_MAX_PENDING caps how many clinics may be awaiting activation at
# once; set it to 0 for operator-created tenants only.
RIS_REGISTRATION_ENABLED=true
RIS_REGISTRATION_MAX_PENDING=50

LOG_CHANNEL=stack
LOG_LEVEL=error

# Hostinger Business: single MySQL database from hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session auth for the React SPA (same-origin cookie sessions).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Sanctum SPA stateful domains (comma separated, include dev origins).
SANCTUM_STATEFUL_DOMAINS=your-portal-domain.com,localhost:3000,127.0.0.1:3000
SESSION_PORTAL_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail (Hostinger: use the account's SMTP credentials from hPanel).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Platform (SaaS) configuration
RIS_SUPER_ADMIN_EMAIL=
RIS_SUPER_ADMIN_PASSWORD=

# Aggregate per-tenant API budget (requests/minute, all users of one clinic).
RIS_TENANT_API_RATE_LIMIT_PER_MINUTE=2400

# Demo data (fake clinic + patients) — local dev / CI e2e ONLY.
# MUST stay false in production: seeders and demo endpoints are inert unless true.
RIS_DEMO_MODE=false
RIS_DEMO_TENANT_CODE=DEMO-2026
RIS_DEMO_ADMIN_EMAIL=
RIS_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# ---- TypeSafe System One screening triage (Vercel AI Gateway) ----
#
# OPT-IN, AND IT SENDS CLINICAL TEXT TO A THIRD-PARTY MODEL HOST. When enabled,
# submitted screening answers, catalog question text and shift-review figures are
# posted to the gateway below. The deterministic risk gate is authoritative and
# nothing clinical depends on this answering — it only helps staff prioritise
# review. Leave OFF unless the clinic has agreed that egress.
#
# Evaluation models (e.g. typesafe-ai/jev) use POST /v1/evaluate on the gateway.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
TYPESAFE_ENABLED=false
TYPESAFE_MODEL=typesafe-ai/jev
# Optional: path to a PEM CA bundle for constrained PHP installs (cURL error 60).
# TYPESAFE_CA_BUNDLE=
