{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "aws/aws-sdk-php": "^3.322",
        "barryvdh/laravel-debugbar": "^3.13",
        "google/apiclient": "^2.17",
        "guzzlehttp/guzzle": "^7.9",
        "kavenegar/php": "^1.2",
        "kkomelin/laravel-translatable-string-exporter": "^1.22",
        "konekt/html": "^6.5",
        "laravel/breeze": "^2.1",
        "laravel/framework": "^11.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "league/flysystem-aws-s3-v3": "^3.28",
        "maatwebsite/excel": "^3.1.x-dev",
        "mailchimp/marketing": "^3.0",
        "mediaburst/clockworksms": "^2.0",
        "melipayamak/php": "^1.0",
        "milon/barcode": "^11.0",
        "orhanerday/open-ai": "^5.2",
        "php-open-source-saver/jwt-auth": "^2.7",
        "pragmarx/google2fa-laravel": "^2.2",
        "rachidlaasri/laravel-installer": "^4.1",
        "santigarcor/laratrust": "^8.3",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "smsgatewayme/client": "^0.0.1",
        "spatie/laravel-google-calendar": "^3.8",
        "twilio/sdk": "^8.3",
        "tzsk/sms": "^8.0",
        "whichbrowser/parser": "^2.1",
        "yajra/laravel-datatables": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
