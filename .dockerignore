# Internal operations material. The image is what the public registry
# distributes: it should carry the application, not the infrastructure
# runbook (server topology, tunnel mechanics, deploy scripts). None of it
# is referenced at runtime.
/docs
/.github

# scripts/ IS shipped: the pixel-true PDF engine shells out to
# scripts/print-pdf.mjs at runtime. Only the operator-only dev helpers are
# left out of the image.
/scripts/dev-*.sh
/scripts/dev-*.py
/scripts/windows
